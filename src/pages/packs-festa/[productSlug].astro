---
import type { GetStaticPaths } from "astro";

import MainLayout from "@/layouts/MainLayout.astro";

import { getProductsByCategory } from "@/lib/products";


export const getStaticPaths = (async () => {
  const packs = await getProductsByCategory("packs-festa");

  return packs.map((product) => ({
    params: { productSlug: product.slug },
    props: { product }
  }));
}) satisfies GetStaticPaths;


const { product } = Astro.props;

const galleryImages = product.gallery.length > 0 ? product.gallery : [product.image];
const showGallery = galleryImages.length > 1;


const formattedPrice =
  product.price !== null
    ? new Intl.NumberFormat("pt-PT", {
        style: "currency",
        currency: "EUR"
      }).format(product.price)
    : product.priceLabel;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description || `Pack Festa ${product.name} da Pali Cakes.`,
  image: new URL(product.image || "/images/og-pali-cakes.jpg", Astro.site).href,
  sku: product.id,
  category: "Packs Festa",
  brand: {
    "@type": "Brand",
    name: "Pali Cakes"
  }
};
---

<MainLayout
  title={`${product.name} | Pali Cakes`}
  description={product.description || `Conheça o ${product.name} da Pali Cakes.`}
  image={product.image || "/images/og-pali-cakes.jpg"}
  schema={productSchema}
>
  <section class="product-detail">
    <div class="container product-detail__container">

      <div class="product-detail__visual" data-gallery>
        <div class="product-detail__image">
          <img
            src={product.image}
            alt={product.name}
            data-gallery-image
          />

          {showGallery && (
            <>
              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--prev"
                data-gallery-prev
                aria-label="Foto anterior"
              >
                ‹
              </button>

              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--next"
                data-gallery-next
                aria-label="Foto seguinte"
              >
                ›
              </button>
            </>
          )}
        </div>

        {showGallery && (
          <div class="product-detail__thumbs">
            {galleryImages.map((src, index) => (
              <button
                type="button"
                class:list={[
                  "product-detail__thumb",
                  { "is-active": index === 0 }
                ]}
                data-gallery-thumb={src}
                aria-label={`Ver foto ${index + 1}`}
                aria-current={index === 0 ? "true" : "false"}
              >
                <img src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>


      <div class="product-detail__content">

        <span class="section-title__eyebrow">
          Pack Festa
        </span>

        <h1>
          {product.name}
        </h1>

        <p class="product-detail__description">
          {product.description}
        </p>


        <div class="product-detail__price">
          <span>Valor</span>

          <strong>
            {formattedPrice}
          </strong>
        </div>


        <div class="product-detail__notice">
          <span aria-hidden="true">✦</span>

          <p>
            Os produtos, as quantidades, os sabores, as cores
            e os detalhes do pack podem ser ajustados de acordo
            com a celebração.
          </p>
        </div>


        <div class="product-detail__actions">
          <button
            type="button"
            class="button button--primary"
            data-add-to-cart
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-image={product.image}
            data-product-price={product.price ?? ""}
            data-product-price-label={product.priceLabel}
            data-category-slug={product.categorySlug}
            data-product-slug={product.slug}
          >
            Adicionar à encomenda
          </button>

          <a
            href="/packs-festa"
            class="button button--secondary"
          >
            Ver outros packs
          </a>
        </div>


        <p class="product-detail__helper">
          O pedido será enviado para orçamento. Não existe
          pagamento online nesta etapa.
        </p>

      </div>

    </div>
  </section>

  <script>
    import "@/scripts/product-gallery.ts";
  </script>
</MainLayout>
