---
import MainLayout from "../../layouts/MainLayout.astro";
import ProductCard from "../../components/products/ProductCard.astro";

import { getProductsByCategory } from "@/lib/products";

const packs = await getProductsByCategory("packs-festa");
---

<MainLayout
  title="Packs Festa | Pali Cakes"
  description="Packs completos para tornar a sua celebração ainda mais especial."
>

<section class="catalog-page">

  <div class="container">

    <div class="catalog-page__header">

      <span class="section-title__eyebrow">
        Packs Pali Cakes
      </span>


      <h1>
        Packs Festa
      </h1>


      <p class="packs-intro__lead">
        Porque celebrar em conjunto também compensa 🤍
      </p>

      <p>
        Os packs foram pensados para tornar a tua festa
        mais simples — e o valor final mais vantajoso.
      </p>

    </div>


    <div class="catalog-grid">

      {
        packs.map((product) => (
          <ProductCard

            name={product.name}

            category="Pack Festa"

            image={product.image}

            href={`/packs-festa/${product.slug}`}

            price={product.price}

            priceLabel={product.priceLabel}

          />
        ))
      }

    </div>


    <div class="packs-cta">

      <div class="packs-cta__content">

        <span class="section-title__eyebrow">
          Não encontrou o pack ideal?
        </span>

        <h2>
          Pack personalizado
        </h2>

        <p>
          Monte o seu pack à medida da sua festa, escolhendo
          as quantidades de cada doce para o número de convidados.
        </p>

      </div>

      <a
        href="/contactos"
        class="button button--primary"
      >
        Pedir pack personalizado
      </a>

    </div>


  </div>

</section>

</MainLayout>