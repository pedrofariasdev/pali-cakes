---
import type { GetStaticPaths } from "astro";

import MainLayout from "@/layouts/MainLayout.astro";

import { getCategories, type CatalogCategory } from "@/lib/categories";
import { getProducts, type Product } from "@/lib/products";


export const getStaticPaths = (async () => {
  const [products, categories] = await Promise.all([
    getProducts(),
    getCategories()
  ]);

  return products
    .filter((product) => product.categorySlug !== "packs-festa")
    .map((product) => ({
      params: {
        slug: product.categorySlug,
        productSlug: product.slug
      },
      props: {
        product,
        category:
          categories.find(
            (c) => c.categorySlug === product.categorySlug
          ) ?? null
      }
    }));
}) satisfies GetStaticPaths;


interface Props {
  product: Product;
  category: CatalogCategory | null;
}

const { product, category } = Astro.props;

const hasFlavors = product.flavors.length > 0;
const canBrowseFlavors = product.flavors.length > 1;
const defaultFlavor = hasFlavors ? product.flavors[0] : null;
const displayImage = defaultFlavor?.imagem || product.image;

const formattedPrice =
  product.price !== null
    ? new Intl.NumberFormat("pt-PT", {
        style: "currency",
        currency: "EUR"
      }).format(product.price)
    : product.priceLabel;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description || `Criação artesanal ${product.name} da Pali Cakes.`,
  image: new URL(product.image || "/images/og-pali-cakes.jpg", Astro.site).href,
  sku: product.id,
  category: category?.name ?? product.categorySlug,
  brand: {
    "@type": "Brand",
    name: "Pali Cakes"
  }
};
---


<MainLayout
  title={`${product.name} | Pali Cakes`}
  description={product.description || `Conheça ${product.name}, uma criação artesanal da Pali Cakes.`}
  image={product.image || "/images/og-pali-cakes.jpg"}
  schema={productSchema}
>

  <section class="product-detail">

    <div class="container product-detail__container">


      <div class="product-detail__visual">

        <div class="product-detail__image">

          <img
            src={displayImage}
            alt={product.name}
            data-product-image-display
          />

          {canBrowseFlavors && (
            <>
              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--prev"
                data-flavor-prev
                aria-label="Sabor anterior"
              >
                ‹
              </button>

              <button
                type="button"
                class="product-detail__image-arrow product-detail__image-arrow--next"
                data-flavor-next
                aria-label="Sabor seguinte"
              >
                ›
              </button>
            </>
          )}

        </div>

      </div>



      <div class="product-detail__content">

        <span class="section-title__eyebrow">
          {category?.name ?? "Pali Cakes"}
        </span>



        <h1>
          {product.name}
        </h1>



        <p class="product-detail__description">
          {product.description}
        </p>



        <div class="product-detail__price">

          <span>
            Valor
          </span>

          <strong>
            {formattedPrice}
          </strong>

        </div>



        {hasFlavors && (
          <div class="product-detail__flavors">

            <span class="product-detail__flavors-label">
              Escolha o sabor
            </span>

            <div
              class="product-detail__flavor-options"
              role="radiogroup"
              aria-label="Sabor"
              data-flavor-group
            >
              {product.flavors.map((flavor, index) => (
                <button
                  type="button"
                  class:list={[
                    "product-detail__flavor-option",
                    { "is-selected": index === 0 }
                  ]}
                  data-flavor-option
                  data-flavor-name={flavor.nome}
                  data-flavor-image={flavor.imagem}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {flavor.nome}
                </button>
              ))}
            </div>

          </div>
        )}



        <div class="product-detail__notice">

          <span aria-hidden="true">
            ✦
          </span>

          <p>
            A decoração, os sabores, as cores e os detalhes
            podem ser personalizados de acordo com a celebração.
          </p>

        </div>



        <div class="product-detail__actions">


          <button
            type="button"
            class="button button--primary"
            data-add-to-cart
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-image={displayImage}
            data-product-price={product.price ?? ""}
            data-product-price-label={product.priceLabel}
            data-category-slug={product.categorySlug}
            data-product-slug={product.slug}
            data-product-flavor={defaultFlavor?.nome ?? ""}
          >
            Adicionar à encomenda
          </button>



          <a
            href={`/catalogo/${product.categorySlug}`}
            class="button button--secondary"
          >
            Voltar à categoria
          </a>


        </div>



        <p class="product-detail__helper">
          O pedido será enviado para orçamento. Não existe pagamento
          online nesta etapa.
        </p>


      </div>


    </div>


  </section>


  <script>
    import "@/scripts/product-flavors.ts";
  </script>


</MainLayout>
