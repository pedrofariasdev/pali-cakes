---
// Instagram real (mesmo link usado na página de contactos).
const INSTAGRAM_URL = "https://www.instagram.com/palicakes/";

// Links genéricos temporários — substituir pelos links oficiais assim que a Bruna os enviar.
const FACEBOOK_URL = "https://www.facebook.com/palicakes";
const TIKTOK_URL = "https://www.tiktok.com/@brunapaliotes";

// Horário de recolha confirmado pela Bruna. Entregas têm horário
// combinado directamente com o cliente (ver formulário de encomenda).
const HORARIO_RECOLHA =
  "Seg a sex, 10h–16h · Sáb, dom e feriados, 10h–12h";
---

<footer class="footer">

  <div class="container footer__container">


    <div class="footer__brand">

      <img
        src="/images/logos/logo-footer.png"
        alt="Pali Cakes"
      >

      <p>
        Bolos personalizados criados
        artesanalmente para momentos especiais.
      </p>

    </div>



    <div class="footer__links">

      <h3>
        Navegação
      </h3>

      <a href="/sobre">
        Sobre
      </a>

      <a href="/catalogo/bolos-personalizados">
        Catálogo
      </a>

      <a href="/packs-festa">
        Packs
      </a>

      <a href="/portfolio">
        Portfólio
      </a>

    </div>




    <div class="footer__links">

      <h3>
        Ajuda
      </h3>

      <a href="/faq">
        FAQ
      </a>

      <a href="/contactos">
        Contactos
      </a>

      <a href="/carrinho">
        Minha encomenda
      </a>

      <a href="/privacidade">
        Privacidade
      </a>

    </div>




    <div class="footer__contact">

      <h3>
        Contacto
      </h3>

      <p>
        Tem alguma dúvida?
      </p>

      <a href="/contactos">
        Contacto
      </a>

      <p class="footer__hours">
        <span>Horário de recolha</span>
        {HORARIO_RECOLHA}
      </p>

    </div>




    <div class="footer__links">

      <h3>
        Redes sociais
      </h3>

      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>

      <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">
        Facebook
      </a>

      <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer">
        TikTok
      </a>

    </div>


  </div>


  <div class="footer__bottom">

    <p>
      © {new Date().getFullYear()} Pali Cakes.
      Todos os direitos reservados.
    </p>

  </div>

</footer>
