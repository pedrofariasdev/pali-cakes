---
import { getCategories } from "@/lib/categories";

const categories = await getCategories();

const catalogCategories = categories.filter(
  (category) => category.categorySlug !== "packs"
);
---

<nav
  class="mobile-menu"
  id="mobile-menu"
  aria-label="Navegação mobile"
  aria-hidden="true"
>
  <div class="mobile-menu__content">
    <a href="/sobre">Sobre</a>

    <details class="mobile-menu__catalog">
      <summary>
        Catálogo
        <span aria-hidden="true">+</span>
      </summary>

      <div class="mobile-menu__submenu">
        {
          catalogCategories.map((category) => (
            <a href={category.href}>
              {category.name}
            </a>
          ))
        }
      </div>
    </details>

    <a href="/packs-festa">Packs Festa</a>
    <a href="/portfolio">Portfólio</a>
    <a href="/contactos">Contactos</a>
    <a href="/faq">FAQ</a>

    <a href="/carrinho" class="mobile-menu__cart">
      Minha encomenda

      <span
        class="mobile-menu__cart-count"
        data-cart-count
      >
        0
      </span>
    </a>
  </div>
</nav>