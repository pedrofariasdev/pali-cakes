---
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pali Cakes | Bolos personalizados",
  description = "Bolos e doces artesanais personalizados para momentos especiais."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-PT">

<head>

  <meta charset="UTF-8" />

  <meta 
    name="viewport" 
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta 
    name="description" 
    content={description}
  />

  <meta name="theme-color" content="#d7a2a8" />

  <link rel="icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link 
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
    rel="stylesheet"
  >

</head>


<body>

  <Navbar />

  <main>
    <slot />
  </main>

  <Footer />

  <script>
  import "../scripts/cart.ts";
</script>

</body>

</html>